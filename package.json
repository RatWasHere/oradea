{
  "productName": "oradea",
  "dependencies": {
    "clusterize.js": "^1.0.0",
    "node-hid": "^2.1.2",
    "osu-mania-parser": "github:anima-ex-inani/osu-mania-parser",
    "slim-select": "^2.12.1",
    "steamworks.js": "^0.4.0"
  },
  "resolutions": {
    "nan": "2.18.0"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "nan": "2.18.0",
    "node-gyp": "10.0.1"
  },
  "scripts": {
    "start": "electron . --no-sandbox",
    "pack": "electron-builder",
    "pack:linux": "electron-builder --linux",
    "pack:windows": "electron-builder --win",
    "pack:mac": "electron-builder --mac"
  },
  "name": "oradea",
  "author": {
    "name": "Rat",
    "email": "ratwashere@proton.me"
  },
  "version": "1.0.0",
  "build": {
    "artifactName": "${productName}.${ext}",
    "executableName": "ORADEA",
    "appId": "com.rat.oradea",
    "icon": "Release/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "executableName": "ORADEA",
      "files": [
        "**/*",
        "launcher.sh"
      ],
      "executableArgs": [
        "--no-sandbox",
        "--disable-setuid-sandbox"
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "appImage": {
      "license": null,
      "executableArgs": [
        "--no-sandbox",
        "--disable-setuid-sandbox"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music"
    },
    "nsis": {
      "oneClick": true,
      "uninstallDisplayName": "Uninstall Bot Maker For Discord"
    },
    "directories": {
      "output": "Release/${platform}"
    }
  },
  "main": "./Core/main.js"
}